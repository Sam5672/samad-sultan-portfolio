{
  "manifest_version": 3,
  "name": "AI Prompt Improver",
  "version": "0.1.0",
  "description": "Improves your AI chat prompts before you send them, grounded only in what you've already written.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-scripts/common.js", "content-scripts/claude.js"],
      "run_at": "document_idle"
    }
  ]
}